---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Phone from '../components/Phone.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { type AppEntry, privacyOf } from '../data/apps';
import { type Lang, href, t } from '../i18n';

interface Props {
  lang: Lang;
  app: AppEntry;
}
const { lang, app } = Astro.props;
const shots = app.screenshots[lang];
const stepsTitle = { en: `A picture in ${app.steps?.length ?? 3} steps`, th: `ทำภาพใน ${app.steps?.length ?? 3} ขั้นตอน` }[lang];
const title = `${app.name} · ${app.tagline[lang]}`;
---

<Base lang={lang} path={`/${app.slug}`} title={title} description={app.summary[lang]} image={app.ogImage}>
  <div class="page" style={`--app:${app.accent};--app-soft:${app.accentSoft}`}>
    <!-- Hero -->
    <section class="ahero">
      <div class="wrap ahero__inner">
        <div class="ahero__copy">
          <a class="back" href={`${href(lang, '/')}#apps`}>← {t(lang, 'app.back')}</a>
          <div class="ahero__id">
            <img class="ahero__icon" src={app.icon} alt="" width="104" height="104" />
            <div class="ahero__chips">
              <span class={`chip ${app.status === 'released' ? 'chip--live' : 'chip--soon'}`}>
                {t(lang, app.status === 'released' ? 'status.released' : 'status.coming')}
              </span>
              <span class="chip">{app.category[lang]}</span>
            </div>
          </div>
          <h1>{app.name}</h1>
          <p class="ahero__tagline">{app.tagline[lang]}</p>
          <p class="lead">{app.summary[lang]}</p>
          <div class="ahero__stores">
            <StoreButtons app={app} lang={lang} />
          </div>
        </div>
        <div class="ahero__art" aria-hidden="true">
          <div class="ahero__phone ahero__phone--back"><Phone src={shots[1].src} alt="" eager /></div>
          <div class="ahero__phone"><Phone src={shots[0].src} alt="" eager /></div>
        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section class="wrap">
      <ul class="stats">
        {
          app.highlights.map((h) => (
            <li>
              <strong>{h.value}</strong>
              <span>{h.label[lang]}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- About + banner -->
    <section class="section about">
      <div class="wrap about__grid">
        <div class="about__copy">
          {app.about.map((p) => <p>{p[lang]}</p>)}
        </div>
        {
          app.banner && (
            <img
              class="about__banner"
              src={app.banner[lang].src}
              alt={app.banner[lang].alt[lang]}
              width="1920"
              height="823"
              loading="lazy"
            />
          )
        }
      </div>
    </section>

    <!-- Steps -->
    {
      app.steps && (
        <section class="wrap">
          <h2 class="h2">{stepsTitle}</h2>
          <ol class="asteps">
            {app.steps.map((s, i) => (
              <li class="card">
                <span class="asteps__n">{i + 1}</span>
                <h3>{s.title[lang]}</h3>
                <p>{s.body[lang]}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- Features -->
    <section class="section">
      <div class="wrap">
        <h2 class="h2">{t(lang, 'app.features')}</h2>
        <ul class="features">
          {
            app.features.map((f) => (
              <li>
                <span class="features__icon"><Icon name={f.icon} /></span>
                <h3>{f.title[lang]}</h3>
                <p>{f.body[lang]}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Screenshots -->
    <section class="shots">
      <div class="wrap">
        <h2 class="h2">{t(lang, 'app.screens')}</h2>
      </div>
      <ul class="shots__rail" tabindex="0" aria-label={t(lang, 'app.screens')}>
        {
          [shots[1], shots[2], shots[0], shots[3]].filter(Boolean).map((s) => (
            <li>
              <Phone src={s.src} alt={s.alt[lang]} />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Gallery -->
    {
      app.gallery && (
        <section class="section">
          <div class="wrap">
            <h2 class="h2">{app.gallery.title[lang]}</h2>
            <ul class="gallery">
              {app.gallery.items[lang].map((g) => (
                <li>
                  <img src={g.src} alt={g.alt[lang]} width="800" height="800" loading="lazy" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Details + privacy -->
    <section class="wrap info">
      <div class="card info__card">
        <h2>{t(lang, 'app.details')}</h2>
        <dl>
          <div>
            <dt>{t(lang, 'app.category')}</dt>
            <dd>{app.category[lang]}</dd>
          </div>
          <div>
            <dt>{t(lang, 'app.platforms')}</dt>
            <dd>
              {app.stores.ios && <span>{app.stores.ios.requires[lang]}</span>}
              {app.stores.android && <span>{app.stores.android.requires[lang]}</span>}
            </dd>
          </div>
          <div>
            <dt>{t(lang, 'app.languages')}</dt>
            <dd>{app.languages[lang]}</dd>
          </div>
          <div>
            <dt>{t(lang, 'app.price')}</dt>
            <dd>{app.price[lang]}</dd>
          </div>
        </dl>
      </div>

      <div class="card info__card">
        <h2>{t(lang, 'app.privacyTitle')}</h2>
        <ul class="ticks">
          {
            privacyOf(app).points.slice(0, 3).map((p) => (
              <li>
                <Icon name="check" size={20} />
                <span>{p[lang]}</span>
              </li>
            ))
          }
        </ul>
        <p class="info__links">
          <a href={href(lang, `/${app.slug}/privacy`)}>{t(lang, 'app.privacyLink')} →</a>
          <a href={href(lang, '/terms')}>{t(lang, 'footer.terms')} →</a>
        </p>
      </div>
    </section>

    <!-- Help -->
    <section class="wrap">
      <div class="ahelp">
        <div>
          <h2>{t(lang, 'app.helpTitle')}</h2>
          <p>{t(lang, 'app.helpBody')}</p>
        </div>
        <a class="btn btn--primary" href={`${href(lang, '/support')}?app=${app.slug}`}>
          {t(lang, 'app.helpCta')} <Icon name="arrow" size={18} />
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .h2 {
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    margin-bottom: clamp(24px, 3.4vw, 40px);
  }

  /* ---------- hero ---------- */
  .ahero {
    background:
      radial-gradient(70% 90% at 85% 10%, var(--app-soft) 0%, transparent 70%),
      radial-gradient(40% 50% at 100% 100%, rgb(245 184 0 / 0.12) 0%, transparent 70%);
    overflow: hidden;
  }
  .ahero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(28px, 5vw, 56px) 0;
  }
  .ahero__copy {
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .back {
    display: inline-block;
    margin-bottom: clamp(24px, 4vw, 40px);
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  .back:hover {
    color: var(--ink);
  }
  .ahero__id {
    display: flex;
    align-items: flex-end;
    gap: 18px;
  }
  .ahero__icon {
    width: 104px;
    height: 104px;
    border-radius: 22.5%;
    box-shadow:
      0 0 0 1px rgb(24 19 31 / 0.08),
      0 14px 30px rgb(24 19 31 / 0.18);
  }
  .ahero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 6px;
  }
  .ahero h1 {
    margin-top: 24px;
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }
  .ahero__tagline {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--app);
  }
  .ahero .lead {
    margin-top: 18px;
  }
  .ahero__stores {
    margin-top: 32px;
  }
  .ahero__art {
    position: relative;
    align-self: end;
    height: clamp(380px, 46vw, 600px);
  }
  .ahero__phone {
    position: absolute;
    width: 56%;
    left: 34%;
    top: 4%;
    transform: rotate(4deg);
  }
  .ahero__phone--back {
    left: 2%;
    top: 16%;
    transform: rotate(-6deg);
    opacity: 0.96;
  }

  /* ---------- stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: clamp(20px, 3vw, 32px) 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-inline: clamp(8px, 2vw, 24px);
  }
  .stats li + li {
    border-left: 1px solid var(--line);
  }
  .stats strong {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--app);
  }
  .stats span {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.35;
  }

  /* ---------- about ---------- */
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .about__copy p {
    font-size: clamp(1.12rem, 1.8vw, 1.3rem);
    color: var(--ink-2);
  }
  .about__copy p + p {
    margin-top: 1em;
  }
  .about__banner {
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-md);
  }

  /* ---------- steps ---------- */
  .asteps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .asteps li {
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-md);
  }
  .asteps__n {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--app);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .asteps h3 {
    margin-top: 18px;
    font-size: 1.35rem;
  }
  .asteps p {
    margin-top: 8px;
    color: var(--ink-2);
  }

  /* ---------- features ---------- */
  .features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 3.4vw, 44px) clamp(20px, 3vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--app-soft);
    color: var(--app);
    --icon-bg: var(--app-soft);
  }
  .features h3 {
    margin-top: 16px;
    font-size: 1.15rem;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .features p {
    margin-top: 8px;
    font-size: 0.98rem;
    color: var(--ink-2);
  }

  /* ---------- screenshots ---------- */
  .shots {
    padding-block: clamp(48px, 7vw, 88px);
    background: var(--paper-2);
  }
  .shots__rail {
    display: flex;
    gap: clamp(16px, 2.6vw, 32px);
    margin: 0;
    padding: 8px max(var(--gutter), calc((100vw - var(--max)) / 2)) 32px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }
  .shots__rail li {
    flex: none;
    width: clamp(220px, 24vw, 268px);
    scroll-snap-align: center;
  }

  /* ---------- gallery ---------- */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2.4vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery img {
    width: 100%;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
  }
  .gallery li:nth-child(1) {
    transform: rotate(-2deg);
  }
  .gallery li:nth-child(3) {
    transform: rotate(2deg);
  }

  /* ---------- info ---------- */
  .info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .info__card {
    padding: clamp(24px, 3.6vw, 40px);
  }
  .info__card h2 {
    font-size: 1.5rem;
    margin-bottom: 18px;
  }
  dl {
    margin: 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    gap: 12px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: 0.95rem;
  }
  dd {
    margin: 0;
    font-weight: 500;
  }
  dd span {
    display: block;
  }
  .ticks {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ticks li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 12px;
    color: var(--ink-2);
  }
  .ticks :global(svg) {
    margin-top: 0.3em;
    color: var(--ok);
    stroke-width: 2.4;
  }
  .info__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 22px;
    font-weight: 500;
  }

  /* ---------- help ---------- */
  .ahelp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(24px, 4vw, 44px);
    border-radius: var(--r-lg);
    background: var(--app-soft);
  }
  .ahelp h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .ahelp p {
    margin-top: 6px;
    color: var(--ink-2);
  }

  @media (max-width: 980px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .ahero__inner,
    .about__grid,
    .info {
      grid-template-columns: minmax(0, 1fr);
    }
    .ahero__copy {
      padding-bottom: 0;
    }
    .ahero__art {
      height: clamp(340px, 92vw, 520px);
      max-width: 480px;
      width: 100%;
      margin-inline: auto;
    }
    .asteps {
      grid-template-columns: minmax(0, 1fr);
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 20px;
    }
    .stats li:nth-child(odd) {
      border-left: 0;
    }
  }
  @media (max-width: 520px) {
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
    .gallery li {
      transform: none !important;
    }
    dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
