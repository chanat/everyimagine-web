---
// A screenshot inside a simple phone frame. Screenshots are 1320×2868 (6.9").
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---

<span class="phone">
  <img src={src} alt={alt} width="720" height="1564" loading={eager ? 'eager' : 'lazy'} decoding="async" />
</span>

<style>
  .phone {
    display: block;
    padding: 2.6%;
    border-radius: 15.5% / 7.2%;
    background: #15121c;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08) inset,
      0 30px 60px -20px rgb(24 19 31 / 0.45),
      0 12px 24px -12px rgb(24 19 31 / 0.3);
  }
  .phone img {
    width: 100%;
    border-radius: 13.5% / 6.2%;
    background: #fff;
  }
</style>
