---
import Logo from './Logo.astro';
import { type Lang, href, t, SUPPORT_EMAIL } from '../i18n';
import { apps } from '../data/apps';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const home = href(lang, '/');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href={home} aria-label="EveryImagine"><Logo uid="foot" /></a>
      <p>{t(lang, 'footer.tagline')}</p>
    </div>

    <nav aria-label={t(lang, 'nav.apps')}>
      <h2>{t(lang, 'nav.apps')}</h2>
      <ul>
        {apps.map((app) => <li><a href={href(lang, `/${app.slug}`)}>{app.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label={t(lang, 'footer.help')}>
      <h2>{t(lang, 'footer.help')}</h2>
      <ul>
        <li><a href={href(lang, '/support')}>{t(lang, 'footer.contact')}</a></li>
        <li><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
      </ul>
    </nav>

    <nav aria-label={t(lang, 'footer.legal')}>
      <h2>{t(lang, 'footer.legal')}</h2>
      <ul>
        <li><a href={href(lang, '/privacy')}>{t(lang, 'footer.privacy')}</a></li>
        <li><a href={href(lang, '/terms')}>{t(lang, 'footer.terms')}</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap site-footer__base">
    <span>© {year} EveryImagine. {t(lang, 'footer.rights')}</span>
    <span>{t(lang, 'footer.made')} 🇹🇭</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(48px, 8vw, 96px);
    background: var(--ink);
    color: rgb(255 255 255 / 0.72);
    font-size: 0.96rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(220px, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 40px 32px;
    padding-block: clamp(48px, 7vw, 80px) 40px;
  }
  .site-footer__brand :global(.logo) {
    color: #fff;
  }
  .site-footer__brand a {
    text-decoration: none;
  }
  .site-footer__brand p {
    margin-top: 16px;
    max-width: 26em;
  }
  h2 {
    margin-bottom: 14px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
  }
  html[lang='th'] h2 {
    letter-spacing: 0.02em;
    font-size: 0.88rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    margin-top: 8px;
  }
  nav a {
    color: rgb(255 255 255 / 0.86);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  nav a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 22px 28px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.55);
  }

  @media (max-width: 820px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
